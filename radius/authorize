# Guest login and session rules. Deployed to /etc/freeradius/3.0/mods-config/files/authorize
#
# The splash page posts this fixed login to the access point, which checks it here.
# The two reply values are the session rules the access point enforces for every guest:
#
#   Session-Timeout   Longest a single session can last, in seconds. 7200 = 2 hours.
#   Idle-Timeout      How long a device can be idle or away before the access point
#                     forgets it, in seconds. 300 = 5 minutes. After that the guest
#                     sees the splash again.
#
# After changing a number, run ./radius/deploy.sh from the repo root.
guest   Cleartext-Password := "guest"
        Session-Timeout := 7200,
        Idle-Timeout := 300
